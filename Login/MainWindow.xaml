<Window x:Class="asset_monitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:asset_monitoring"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Background="#F3F4F6">
        <Border Width="380"
            Padding="35"
            Background="White"
            CornerRadius="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="ASSET MANAGEMENT"
                       FontSize="23"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#299617"
                       Margin="0,0,0,8"/>

                <TextBlock Text="IT Department"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       Margin="0,0,0,30"/>

                <TextBlock Text="Username"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

                <TextBox Height="38"
                     FontSize="14"
                     Padding="8"
                     Margin="0,0,0,18"/>

                <TextBlock Text="Password"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

                <PasswordBox Height="38"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,25"/>

                <Button Content="LOG IN"
                    Height="42"
                    Background="#299617"
                    Foreground="white"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>

                <TextBlock Text="IT Department Asset Management System"
                       FontSize="10"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,25,0,0"/>

            </StackPanel>
        </Border>
    </Grid>

</Window>
