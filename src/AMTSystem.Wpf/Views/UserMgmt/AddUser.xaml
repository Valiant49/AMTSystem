<UserControl
    x:Class="AMTSystem.Wpf.Views.UserMgmt.AddUser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.UserMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="100,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="8">
                <TextBlock Text="User Information" />

                <TextBlock Text="First Name *" />
                <TextBox
                    x:Name="FirstNameBox"
                    Margin="0,0,4,8"
                    Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="NameBox_TextChanged" />

                <TextBlock Text="Middle Name" />
                <TextBox
                    x:Name="MiddleNameBox"
                    Margin="0,0,4,8"
                    Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Last Name *" />
                <TextBox
                    x:Name="LastNameBox"
                    Margin="0,0,4,8"
                    Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="NameBox_TextChanged" />

                <TextBlock Text="Username" />
                <TextBox
                    x:Name="UsernameBox"
                    Margin="0,0,4,8"
                    IsReadOnly="True" />
                <!--  Text="{Binding Username, Mode=OneWay}"  -->
                <!--  comment above for future use  -->

                <TextBlock x:Name="ErrorText" Foreground="Red" />
                <TextBlock Text="Password *" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,4,8" />

                <TextBlock Text="Confirm Password *" />
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,4,8" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8">
                <TextBlock Text="Account" />

                <TextBlock Text="Role *" />
                <ComboBox
                    x:Name="RoleBox"
                    Margin="0,0,4,8"
                    DisplayMemberPath="Role"
                    IsEditable="True"
                    IsReadOnly="True"
                    SelectedValue="{Binding RoleId}"
                    SelectedValuePath="Id"
                    Text="Please select a role..." />

                <TextBlock Text="Account Status *" />
                <ComboBox
                    x:Name="AccountStatusBox"
                    Margin="0,0,4,8"
                    DisplayMemberPath="Status"
                    IsEditable="True"
                    IsReadOnly="True"
                    SelectedValue="{Binding StatusId}"
                    SelectedValuePath="Id"
                    Text="Please select a status..." />

                <TextBlock Text="Created At" />
                <TextBox
                    x:Name="CreatedAtBox"
                    Margin="0,0,4,8"
                    IsReadOnly="True"
                    Text="{Binding CreatedAt, Mode=OneWay, StringFormat=g}" />

                <TextBlock Text="Updated At" />
                <TextBox
                    x:Name="UpdatedAtBox"
                    Margin="0,0,4,8"
                    IsReadOnly="True"
                    Text="{Binding UpdatedAt, Mode=OneWay, StringFormat=g}" />
            </StackPanel>
        </Grid>

        <DockPanel
            Grid.Row="1"
            Margin="100,8"
            LastChildFill="False">
            <Button
                Padding="64,16"
                Click="SubmitButton_Click"
                Content="Save"
                DockPanel.Dock="Right" />
            <Button
                Margin="0,0,8,0"
                Padding="64,16"
                Click="CancelButton_Click"
                Content="Cancel"
                DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</UserControl>
