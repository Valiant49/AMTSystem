<UserControl
    x:Class="AMTSystem.Wpf.Views.UserMgmt.ManageUsers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.UserMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!--  USER SELECTION AND EDITING  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!--  USER LIST  -->
            <DockPanel Grid.Column="0" Margin="8,6">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="User List" />

                    <TextBlock Text="Search Users" />

                    <TextBox x:Name="UserSearchBox" TextChanged="UserSearchBox_TextChanged" />
                </StackPanel>

                <Button
                    x:Name="SelectUserButton"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    Click="SelectUserButton_Click"
                    Content="Select User"
                    DockPanel.Dock="Bottom" />

                <DataGrid
                    x:Name="UserGrid"
                    Margin="0,10,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding FullName}"
                            Header="Full Name" />

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Username}"
                            Header="Username" />

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Role}"
                            Header="Role" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!--  USER DETAILS  -->
            <DockPanel Grid.Column="1" Margin="8,6">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="User Details" />

                    <TextBlock Text="Select a user on the left to edit their details" />
                </StackPanel>

                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">

                    <Grid x:Name="EditForm" IsEnabled="False">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  FIRST NAME  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="First Name:" />

                        <TextBox
                            x:Name="FirstNameBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  MIDDLE NAME  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Middle Name:" />

                        <TextBox
                            x:Name="MiddleNameBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  LAST NAME  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Last Name:" />

                        <TextBox
                            x:Name="LastNameBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  USERNAME  -->
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Username:" />

                        <TextBox
                            x:Name="UsernameBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  ROLE  -->
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Role:" />

                        <ComboBox
                            x:Name="RoleCombo"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            SelectionChanged="FormSelectionChanged" />

                        <!--  STATUS  -->
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Text="Status:" />

                        <ComboBox
                            x:Name="StatusCombo"
                            Grid.Row="5"
                            Grid.Column="1"
                            SelectionChanged="FormSelectionChanged" />

                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!--  ACTION BUTTONS  -->
        <DockPanel
            Grid.Row="3"
            Margin="8"
            VerticalAlignment="Bottom"
            LastChildFill="False">

            <Button
                x:Name="SaveButton"
                Padding="64,16"
                Click="SaveButton_Click"
                Content="Save Changes"
                DockPanel.Dock="Right"
                IsEnabled="False" />

            <Button
                x:Name="CancelButton"
                Margin="0,0,8,0"
                Padding="64,16"
                Click="CancelButton_Click"
                Content="Cancel"
                DockPanel.Dock="Right" />

        </DockPanel>
    </Grid>
</UserControl>
