<UserControl
    x:Class="AMTSystem.Wpf.Views.PersonnelMgmt.AddPersonnel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.PersonnelMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="100,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!--<ColumnDefinition Width="*" />-->
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="8">
                <TextBlock Text="First Name" />
                <TextBox Margin="0,0,4,8" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Middle Name" />
                <TextBox Margin="0,0,4,8" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Last Name" />
                <TextBox Margin="0,0,4,8" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Employee No." />
                <TextBox Margin="0,0,4,8" Text="{Binding EmployeeNo, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Department" />
                <!--<ComboBox
                    x:Name="DepartmentBox"
                    Margin="0,0,4,8"
                    DisplayMemberPath="Department_Name"
                    IsEditable="False"
                    SelectedValue="{Binding Departmen_Name}"
                    SelectedValuePath="Id" />-->

                <ComboBox
                    x:Name="DepartmentBox"
                    Margin="0,0,4,8"
                    DisplayMemberPath="DepartmentName"
                    SelectedValue="{Binding DepartmentId}"
                    SelectedValuePath="Id" />


                <Button
                    Padding="64,16"
                    HorizontalAlignment="Right"
                    Click="SubmitButton_Click"
                    Content="Submit" />
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" />
    </Grid>
</UserControl>
