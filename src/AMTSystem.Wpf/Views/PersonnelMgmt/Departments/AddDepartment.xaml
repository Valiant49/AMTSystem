<UserControl
    x:Class="AMTSystem.Wpf.Views.PersonnelMgmt.Departments.AddDepartment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.PersonnelMgmt.Departments"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">


            <DataGrid
                x:Name="DepartmentGrid"
                Margin="10"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding DepartmentName}"
                        Header="Departments" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Column="1" Margin="64,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,150">
                <TextBlock Text="Department" />
                <TextBox x:Name="DeptInput" Margin="0,0,4,8" />
                <Button
                    Width="75"
                    HorizontalAlignment="Right"
                    Click="Dept_Submit_Clicked"
                    Content="Submit" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
