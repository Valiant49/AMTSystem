<UserControl
    x:Class="AMTSystem.Wpf.Views.PersonnelMgmt.EditPersonnel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.PersonnelMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!--  PERSONNEL SELECTION AND EDITING  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!--  PERSONNEL LIST  -->
            <DockPanel Grid.Column="0" Margin="8,6">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="Personnel List" />

                    <TextBlock Text="Search Personnel" />

                    <TextBox x:Name="PersonnelSearchBox" TextChanged="PersonnelSearchBox_TextChanged" />
                </StackPanel>

                <Button
                    x:Name="SelectPersonnelButton"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    Click="SelectPersonnelButton_Click"
                    Content="Select Personnel"
                    DockPanel.Dock="Bottom" />

                <DataGrid
                    x:Name="PersonnelGrid"
                    Margin="0,10,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding EmployeeNo}"
                            Header="Employee No." />

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Name}"
                            Header="Full Name" />

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Department}"
                            Header="Department" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!--  PERSONNEL DETAILS  -->
            <DockPanel Grid.Column="1" Margin="8,6">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="Personnel Details" />

                    <TextBlock Text="Select personnel on the left to edit their details" />
                </StackPanel>

                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">

                    <Grid x:Name="EditForm" IsEnabled="False">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  EMPLOYEE NUMBER  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Employee No.:" />

                        <TextBox
                            x:Name="EmployeeNoBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            IsReadOnly="True" />

                        <!--  FIRST NAME  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="First Name:" />

                        <TextBox
                            x:Name="FirstNameBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  MIDDLE NAME  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Middle Name:" />

                        <TextBox
                            x:Name="MiddleNameBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  SURNAME  -->
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Surname:" />

                        <TextBox
                            x:Name="SurnameBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  POSITION  -->
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Position:" />

                        <TextBox
                            x:Name="PositionBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  DEPARTMENT  -->
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Department:" />

                        <TextBox
                            x:Name="DepartmentBox"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  EMPLOYEE TYPE  -->
                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Text="Employee Type:" />

                        <ComboBox
                            x:Name="EmployeeTypeCombo"
                            Grid.Row="6"
                            Grid.Column="1"
                            SelectionChanged="FormSelectionChanged">

                            <ComboBoxItem Content="Full-Time" />
                            <ComboBoxItem Content="Part-Time" />

                        </ComboBox>

                        <!--  STATUS  -->
                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Text="Status:" />

                        <ComboBox
                            x:Name="StatusCombo"
                            Grid.Row="7"
                            Grid.Column="1"
                            SelectionChanged="FormSelectionChanged">

                            <ComboBoxItem Content="Active" />
                            <ComboBoxItem Content="Inactive" />

                        </ComboBox>


                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>



        <!--  ACTION BUTTONS  -->
        <DockPanel
            Grid.Row="3"
            Margin="8"
            VerticalAlignment="Bottom"
            LastChildFill="False">

            <Button
                x:Name="SaveButton"
                Padding="64,16"
                Click="SaveButton_Click"
                Content="Save Changes"
                DockPanel.Dock="Right"
                IsEnabled="False" />

            <Button
                Margin="0,0,8,0"
                Padding="64,16"
                Click="CancelButton_Click"
                Content="Cancel"
                DockPanel.Dock="Right" />

        </DockPanel>

    </Grid>
</UserControl>
