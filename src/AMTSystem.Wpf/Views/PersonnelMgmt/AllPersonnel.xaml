<UserControl
    x:Class="AMTSystem.Wpf.Views.PersonnelMgmt.AllPersonnel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.PersonnelMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <DataGrid
            x:Name="PersonnelGrid"
            Margin="10"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True">
            <DataGrid.Columns>
                <!--<DataGridTextColumn
                    Width="*"
                    Binding="{Binding Id}"
                    Header="ID" />-->
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding FullName}"
                    Header="Personnel Name" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Department}"
                    Header="Department" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Status}"
                    Header="Status" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding EmployeeNo}"
                    Header="Employee No." />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
