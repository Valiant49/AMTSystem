<UserControl
    x:Class="AMTSystem.Wpf.Views.AssetMgmt.AllAssetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.AssetMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <DataGrid
            x:Name="AssetGrid"
            Margin="10"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="ID" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding SerialNumber}"
                    Header="Tag" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding SerialNumber}"
                    Header="Serial No." />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Status_String}"
                    Header="Status" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Category_String}"
                    Header="Category" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Condition_String}"
                    Header="Condition" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Manufacturer}"
                    Header="Manufacturer" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Model}"
                    Header="Model" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Components}"
                    Header="Components" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
