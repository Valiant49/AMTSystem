<UserControl
    x:Class="AMTSystem.Wpf.Views.AssetMgmt.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.AssetMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="128,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="8">

                <TextBlock Text="Name" />
                <TextBox Margin="0,0,4,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Serial Number" />
                <TextBox Margin="0,0,4,8" Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Description" />
                <TextBox Margin="0,0,4,8" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Components" />
                <TextBox Height="100" Text="{Binding Components, UpdateSourceTrigger=PropertyChanged}" />


            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8">
                <TextBlock Text="Category" />
                <ComboBox
                    x:Name="CategoryBox"
                    DisplayMemberPath="Name"
                    SelectedValue="{Binding CategoryId}"
                    SelectedValuePath="Id" />

                <TextBlock Text="Status" />
                <ComboBox
                    x:Name="StatusBox"
                    DisplayMemberPath="Name"
                    SelectedValue="{Binding StatusId}"
                    SelectedValuePath="Id" />

                <TextBlock Text="Condition" />
                <ComboBox
                    x:Name="ConditionBox"
                    DisplayMemberPath="Name"
                    SelectedValue="{Binding ConditionId}"
                    SelectedValuePath="Id" />

                <TextBlock Text="Manufacturer" />
                <ComboBox
                    x:Name="ManufacturerBox"
                    IsEditable="True"
                    Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Model" />
                <ComboBox
                    x:Name="ModelBox"
                    DropDownOpened="ModelBox_DropdownOpened"
                    IsEditable="True"
                    Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1">
            <Button
                Padding="64,16"
                HorizontalAlignment="Right"
                Click="Submit_Clicked"
                Content="Submit" />
        </DockPanel>


    </Grid>
</UserControl>
