<UserControl
    x:Class="AMTSystem.Wpf.Views.AssetMgmt.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <TextBlock Text="Name" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Serial Number" />
            <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Description" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Category" />
            <ComboBox SelectedIndex="0">
                <ComboBoxItem Content="Select a category..." IsEnabled="False" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
            </ComboBox>

            <!--<TextBlock Text="Status" />
            <ComboBox SelectedIndex="0">
                <ComboBoxItem Content="Select a status..." IsEnabled="False" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
            </ComboBox>-->

            <TextBlock Text="Condition" />
            <ComboBox SelectedIndex="0">
                <ComboBoxItem Content="Select asset's condition..." IsEnabled="False" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
            </ComboBox>

            <TextBlock Text="Components" />
            <TextBox Height="100" Text="{Binding Components, UpdateSourceTrigger=PropertyChanged}" />

            <Button Click="Next_Click" Content="Next" />
        </StackPanel>



    </Grid>
</UserControl>
