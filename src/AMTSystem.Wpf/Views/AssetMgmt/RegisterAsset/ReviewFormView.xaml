<UserControl
    x:Class="AMTSystem.Wpf.Views.AssetMgmt.ReviewFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.AssetMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <TextBlock
            Margin="21,20,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="REVIEW INFO"
            TextWrapping="Wrap" />

        <!--  Name Field  -->
        <TextBlock
            Margin="71,51,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Name"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="185,54,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="{Binding Name}"
            TextWrapping="Wrap" />

        <!--  Sereial Number  -->
        <TextBlock
            Margin="71,100,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Serial Number"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="185,103,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="{Binding SerialNumber}"
            TextWrapping="Wrap" />

        <!--  Status  -->
        <TextBlock
            Margin="71,144,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Status"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="185,144,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="{Binding Status}"
            TextWrapping="Wrap" />

        <!--  Condition  -->
        <TextBlock
            Margin="71,186,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Condition"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="185,186,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="{Binding Condition}"
            TextWrapping="Wrap" />

        <!--  Components  -->
        <TextBlock
            Margin="71,225,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Components"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="185,225,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="{Binding Components}"
            TextWrapping="Wrap" />

        <Button
            Margin="252,359,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Back_Click"
            Content="Back" />
        <Button
            Margin="527,349,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Submit_Click"
            Content="Submit" />

    </Grid>
</UserControl>
