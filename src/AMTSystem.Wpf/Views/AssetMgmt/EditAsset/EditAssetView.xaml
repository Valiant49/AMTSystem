<UserControl
    x:Class="AMTSystem.Wpf.Views.AssetMgmt.EditAssetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.AssetMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Editing Officer: " />
                <TextBlock x:Name="EditingOfficerText" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Date Modified: " />
                <DatePicker x:Name="DateModifiedPicker" Width="200" />
            </StackPanel>
        </Grid>

        <!--  ASSET SELECTION AND EDITING  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!--  ASSET LIST  -->
            <DockPanel Grid.Column="0" Margin="8,6">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="Assets" />

                    <TextBlock Text="Search assets" />

                    <TextBox x:Name="AssetSearchBox" TextChanged="AssetSearchBox_TextChanged" />
                </StackPanel>

                <Button
                    x:Name="SelectAssetButton"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    Click="SelectAssetButton_Click"
                    Content="Select Asset"
                    DockPanel.Dock="Bottom" />

                <DataGrid
                    x:Name="AssetGrid"
                    Margin="0,10,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Tag}"
                            Header="Tag" />

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Name}"
                            Header="Asset Name" />

                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Condition_String}"
                            Header="Condition" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!--  EDITABLE ASSET DETAILS  -->
            <DockPanel Grid.Column="1" Margin="8,6">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="Asset Details" />

                    <TextBlock Text="Select an asset on the left to edit its details" />
                </StackPanel>

                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">

                    <Grid x:Name="EditForm" IsEnabled="False">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  TAG  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Tag:" />

                        <TextBox
                            x:Name="TagBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            IsReadOnly="True" />

                        <!--  ASSET NAME  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Asset Name:" />

                        <TextBox
                            x:Name="NameBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  SERIAL NUMBER  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Serial No.:" />

                        <TextBox
                            x:Name="SerialNumberBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  CATEGORY  -->
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Category:" />

                        <ComboBox
                            x:Name="CategoryCombo"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            SelectionChanged="FormSelectionChanged" />

                        <!--  CONDITION  -->
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Condition:" />

                        <ComboBox
                            x:Name="ConditionCombo"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            SelectionChanged="FormSelectionChanged" />

                        <!--  MANUFACTURER  -->
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            Text="Manufacturer:" />

                        <TextBox
                            x:Name="ManufacturerBox"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            TextChanged="FormTextChanged" />

                        <!--  MODEL  -->
                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Text="Model:" />

                        <TextBox
                            x:Name="ModelBox"
                            Grid.Row="6"
                            Grid.Column="1"
                            TextChanged="FormTextChanged" />

                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!--  REVIEW  -->
        <StackPanel Grid.Row="2" Margin="8,6">

            <Separator Margin="0,0,0,8" />

            <TextBlock
                Margin="0,0,0,4"
                FontWeight="SemiBold"
                Text="Review" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Editing: " />
                <TextBlock x:Name="ReviewAssetText" Text="(no asset selected)" />
            </StackPanel>

            <TextBlock
                x:Name="ReviewCountText"
                Margin="0,2,0,0"
                Text="Fields changed: 0" />

            <DataGrid
                x:Name="ReviewGrid"
                MaxHeight="120"
                Margin="0,6,0,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserReorderColumns="False"
                IsReadOnly="True">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding Field}"
                        Header="Field" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding OldValue}"
                        Header="Old Value" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding NewValue}"
                        Header="New Value" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Margin="0,6,0,2" Text="Remarks" />

            <TextBox x:Name="RemarksBox" />

        </StackPanel>

        <!--  ACTION BUTTONS  -->
        <DockPanel
            Grid.Row="3"
            Margin="8"
            VerticalAlignment="Bottom"
            LastChildFill="False">

            <Button
                x:Name="SaveButton"
                Padding="64,16"
                Click="SaveButton_Click"
                Content="Save Changes"
                DockPanel.Dock="Right"
                IsEnabled="False" />

            <Button
                Margin="0,0,8,0"
                Padding="64,16"
                Click="CancelButton_Click"
                Content="Cancel"
                DockPanel.Dock="Right" />

        </DockPanel>

    </Grid>
</UserControl>
