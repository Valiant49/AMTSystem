<UserControl
    x:Class="AMTSystem.Wpf.Views.AssetMgmt.ReturnView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Views.AssetMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Code-behind sets HeldItemsView.Source = the person's open items  -->
        <CollectionViewSource x:Key="HeldItemsView">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="BatchId" />
            </CollectionViewSource.GroupDescriptions>
            <!--<CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="BatchId" />
                <scm:SortDescription PropertyName="Tag" />
            </CollectionViewSource.SortDescriptions>-->
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Returning Officer: " />
                <TextBlock x:Name="ReturningOfficerText" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Date Returned: " />
                <TextBlock x:Name="ReturnDateText" />
            </StackPanel>
        </Grid>

        <!--  Body  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!--  Find personnel  -->
            <DockPanel Grid.Column="0" Margin="8,6">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontWeight="SemiBold" Text="Personnel" />
                    <TextBlock Text="Search personnel" />
                    <TextBox x:Name="PersonnelSearchBox" TextChanged="PersonnelSearchBox_TextChanged" />
                    <TextBlock Margin="0,6,0,0" Text="Scan asset tag" />
                    <TextBox x:Name="TagSearchBox" KeyDown="TagSearchBox_KeyDown" />
                </StackPanel>

                <Button
                    x:Name="SelectPersonnelButton"
                    Margin="0,8,0,0"
                    Click="SelectPersonnelButton_Click"
                    Content="Select Personnel"
                    DockPanel.Dock="Bottom" />

                <DataGrid
                    x:Name="PersonnelGrid"
                    Margin="0,10,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding EmployeeNo}"
                            Header="Emp. No." />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding FullName}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Department}"
                            Header="Department" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!--  Items currently held  -->
            <DockPanel Grid.Column="1" Margin="8,6">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontWeight="SemiBold" Text="Items Currently Held" />
                    <CheckBox
                        x:Name="SelectAllCheckBox"
                        Margin="0,4,0,0"
                        Click="SelectAllCheckBox_Click"
                        Content="Select all" />
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <DataGrid
                        x:Name="HeldItemsGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        ItemsSource="{Binding Source={StaticResource HeldItemsView}}"
                        SelectionMode="Single">

                        <!--  Collapsible group header per batch, with a batch-level checkbox  -->
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Click="BatchCheckBox_Click"
                                                                    Tag="{Binding Name}" />
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name, StringFormat=Batch #{0}}" />
                                                                <TextBlock Margin="8,0,0,0" Text="{Binding ItemCount, StringFormat=({0} items)}" />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Header="Return" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Tag}"
                                Header="Tag"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Category_String}"
                                Header="Category"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Model}"
                                Header="Model"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding TransactionType}"
                                Header="Type"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding TransactionDate, StringFormat=d}"
                                Header="Date Out"
                                IsReadOnly="True" />

                            <DataGridTemplateColumn Width="140" Header="Condition at Return">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding Conditions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            SelectedValue="{Binding ConditionAtReturnId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id"
                                            SelectionChanged="ConditionComboBox_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ReturnRemarks, UpdateSourceTrigger=LostFocus}"
                                Header="Remarks" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  Empty state, toggle Visibility from code-behind  -->
                    <TextBlock
                        x:Name="EmptyStateText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Select a personnel to see their items." />
                </Grid>
            </DockPanel>
        </Grid>

        <!--  Review  -->
        <StackPanel Grid.Row="2" Margin="8,6">
            <Separator Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Returning from: " />
                <TextBlock x:Name="ReviewPersonnelText" Text="(no personnel selected)" />
            </StackPanel>
            <TextBlock x:Name="ReviewCountText" Text="Items to return: 0 of 0" />
            <TextBlock
                x:Name="DamagedWarningText"
                Foreground="DarkOrange"
                Text="Items marked damaged will be set to Under Repair."
                Visibility="Collapsed" />
        </StackPanel>

        <!--  Actions  -->
        <DockPanel
            Grid.Row="3"
            Margin="8"
            LastChildFill="False">
            <Button
                x:Name="ReturnButton"
                Padding="64,16"
                Click="ReturnButton_Click"
                Content="Return Selected"
                DockPanel.Dock="Right"
                IsEnabled="False" />
            <Button
                Margin="0,0,8,0"
                Padding="64,16"
                Click="CancelButton_Click"
                Content="Cancel"
                DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</UserControl>
