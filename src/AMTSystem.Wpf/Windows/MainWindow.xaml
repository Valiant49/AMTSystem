<Window
    x:Class="AMTSystem.Wpf.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AMTSystem"
    Width="1280"
    Height="720"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  Style for sidebar buttons  -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#080808" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#cbcbcb" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style for section headers  -->
        <Style x:Key="NavHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="DarkGreen" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Margin" Value="4,18,4,4" />
        </Style>

        <Style x:Key="SystemTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="DarkGreen" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Margin" Value="4,4,4,4" />
            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Background="DarkSeaGreen">
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{DynamicResource SystemTitle}"
                Text="ASSET MONITORING SYSTEM"
                TextAlignment="Center" />
        </Border>
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="DarkSeaGreen">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <Button
                        Click="Nav_Click"
                        Content="Dashboard"
                        Style="{StaticResource NavButton}"
                        Tag="Dashboard" />

                    <TextBlock Style="{StaticResource NavHeader}" Text="ASSET MANAGEMENT" />
                    <Button
                        Click="Nav_Click"
                        Content="All Assets"
                        Style="{StaticResource NavButton}"
                        Tag="AllAssets" />
                    <Button
                        Click="Nav_Click"
                        Content="Register"
                        Style="{StaticResource NavButton}"
                        Tag="Register" />
                    <Button
                        Click="Nav_Click"
                        Content="Issue"
                        Style="{StaticResource NavButton}"
                        Tag="Issue" />
                    <Button
                        Click="Nav_Click"
                        Content="Lend"
                        Style="{StaticResource NavButton}"
                        Tag="Lend" />
                    <Button
                        Click="Nav_Click"
                        Content="Return"
                        Style="{StaticResource NavButton}"
                        Tag="Return" />

                    <TextBlock Style="{StaticResource NavHeader}" Text="REPORT &amp; ANALYTICS" />
                    <Button
                        Click="Nav_Click"
                        Content="Activity Reports"
                        Style="{StaticResource NavButton}"
                        Tag="ActivityReports" />
                    <Button
                        Click="Nav_Click"
                        Content="Generate Documents"
                        Style="{StaticResource NavButton}"
                        Tag="GeneratedDocs" />

                    <TextBlock Style="{StaticResource NavHeader}" Text="USER MANAGEMENT" />
                    <Button
                        Click="Nav_Click"
                        Content="System Users"
                        Style="{StaticResource NavButton}"
                        Tag="SystemUsers" />
                    <Button
                        Click="Nav_Click"
                        Content="Roles and Permissions"
                        Style="{StaticResource NavButton}"
                        Tag="Roles" />
                    <Button
                        Click="Nav_Click"
                        Content="Personnel Records"
                        Style="{StaticResource NavButton}"
                        Tag="Personnel" />
                    <Button
                        Click="Nav_Click"
                        Content="Activity Log"
                        Style="{StaticResource NavButton}"
                        Tag="ActivityLog" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ContentControl
            x:Name="TopBar"
            Grid.Row="0"
            Grid.Column="1"
            Margin="4,4,4,4">
            <TextBlock
                x:Name="HeaderText"
                VerticalAlignment="Center"
                FontSize="24"
                Text="Welcome, user." />
        </ContentControl>

        <ContentControl
            x:Name="ContentArea"
            Grid.Row="1"
            Grid.Column="1"
            Margin="16"
            Background="Green" />
    </Grid>
</Window>
