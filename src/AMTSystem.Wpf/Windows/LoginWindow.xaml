<Window
    x:Class="AMTSystem.Wpf.Windows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Asset Monitoring System - IT DEPT"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Label
            Margin="0,147,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="ASSET MANAGEMENT" />
        <Label
            Margin="0,173,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="IT DEPARTMENT" />

        <Label
            Margin="336,228,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Username:" />
        <TextBox
            Name="txbUsername"
            Width="120"
            Margin="0,249,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            TextChanged="InputField_Changed"
            TextWrapping="Wrap" />

        <Label
            Margin="336,267,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Password:" />
        <PasswordBox
            Name="txbPassword"
            Width="120"
            Margin="0,289,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            PasswordChanged="InputField_Changed" />
        <Button
            x:Name="btnLogin"
            Margin="0,354,0,0"
            Padding="8,4,8,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Click="btnLogin_Click"
            Content="LOGIN" />
    </Grid>
</Window>
