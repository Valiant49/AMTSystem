<Window
    x:Class="AMTSystem.Wpf.Windows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMTSystem.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Asset Monitoring System - IT DEPT"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Border
            Width="380"
            Padding="35"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="12">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontSize="23"
                    FontWeight="Bold"
                    Foreground="#299617"
                    Text="ASSET MANAGEMENT" />
                <TextBlock
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="Gray"
                    Text="IT Department" />
                <TextBlock
                    Margin="0,0,0,7"
                    FontWeight="SemiBold"
                    Text="Username" />
                <TextBox
                    Name="txbUsername"
                    Height="38"
                    Margin="0,0,0,18"
                    Padding="8"
                    FontSize="14"
                    TextChanged="InputField_Changed" />
                <TextBlock
                    Margin="0,0,0,7"
                    FontWeight="SemiBold"
                    Text="Password" />
                <PasswordBox
                    Name="txbPassword"
                    Height="38"
                    Margin="0,0,0,25"
                    Padding="8"
                    FontSize="14"
                    PasswordChanged="InputField_Changed" />
                <Button
                    x:Name="btnLogin"
                    Height="42"
                    Background="#299617"
                    BorderThickness="0"
                    Click="btnLogin_Click"
                    Content="LOG IN"
                    Cursor="Hand"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="white" />
                <TextBlock
                    Margin="0,25,0,0"
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Foreground="Gray"
                    Text="IT Department Asset Management System" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
